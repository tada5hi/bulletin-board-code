{
    "name": "bulletin-board-code",
    "version": "1.0.3",
    "description": "Bidirectional convert between BBCode and HTML.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/bulletin-board-code.git"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist/",
        ".github/assets"
    ],
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "build:watch": "tsdown --watch",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "lint": "eslint src test AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "npx husky install",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "bulletin-board-code",
        "bbcode",
        "html",
        "parser",
        "bbcode-to-html",
        "html-to-bbcode",
        "tokenizer"
    ],
    "license": "MIT",
    "devDependencies": {
        "@swc/core": "^1.15.8",
        "@tada5hi/commitlint-config": "^1.2.7",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "husky": "^9.1.7",
        "rimraf": "^6.1.2",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "node-html-parser": "^7.0.2"
    }
}
